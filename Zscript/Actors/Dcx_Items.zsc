Class MasterLevelsCompleted : Inventory
{
	Default
	{
		+INVENTORY.PERSISTENTPOWER
		+INVENTORY.UNCLEARABLE
		+INVENTORY.QUIET
		+INVENTORY.UNTOSSABLE
		Inventory.MaxAmount 5;
	}
}

