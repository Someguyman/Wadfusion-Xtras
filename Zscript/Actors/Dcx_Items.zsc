
Class Stimpack_BFG : Stimpack 
{
	States
	{
	Spawn:
		STIM B -1;
		Stop;
	}
}

Class Medikit_BFG : Medikit 
{
	States
	{
	Spawn:
		MEDI B -1;
		Stop;
	}
}

Class Berserk_BFG : Berserk 
{
	States
	{
	Spawn:
		PSTR B -1 bright;
		Stop;
	}
}

